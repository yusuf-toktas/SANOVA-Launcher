# Build output
[Bb]in/
[Oo]bj/
artifacts/
publish/
Releases/
*.nupkg
*.snupkg

# IDE / tooling
.vs/
.vscode/*
!.vscode/extensions.json
.idea/
*.user
*.suo
*.userprefs
*.DotSettings.user

# Test results and coverage
TestResults/
[Tt]est[Rr]esult*/
