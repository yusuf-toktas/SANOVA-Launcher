# Visual snapshots rendered by UI tests (regenerated on each run)
tests/**/snapshots/

# Local secrets — manifest signing keys must never be committed
*.pem
!**/*public-key*.pem
*.key
*.pfx
*.p12
.env
.env.*
secrets/

# Logs
*.log

# OS noise
Thumbs.db
Desktop.ini
.DS_Store

# Local content builds produced by the manifest tool
content-out/
