<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sanova.Launcher.ViewModels"
             xmlns:l="using:Sanova.Launcher.Infrastructure"
             x:Class="Sanova.Launcher.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
  <UserControl.DataTemplates>
    <DataTemplate x:DataType="vm:ChoiceOption">
      <TextBlock Text="{Binding Label.Value}" />
    </DataTemplate>
  </UserControl.DataTemplates>
  <ScrollViewer>
    <StackPanel Classes="page">
      <StackPanel Spacing="8">
        <TextBlock Text="{l:Tr settings.title}" Classes="h1" />
        <TextBlock Text="{l:Tr settings.lede}" Classes="lede" />
      </StackPanel>

      <!-- General -->
      <StackPanel Spacing="12">
        <TextBlock Text="{l:Tr settings.general}" Classes="h2" />
        <Border Classes="group">
          <StackPanel>
            <Border Classes="row">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="3" Margin="0,0,24,0">
                  <TextBlock Text="{l:Tr settings.language.title}" Classes="h3" />
                  <TextBlock Text="{l:Tr settings.language.body}" Classes="small muted wrap" />
                </StackPanel>
                <ComboBox Grid.Column="1" ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}" VerticalAlignment="Center" />
              </Grid>
            </Border>
            <Border Classes="row last">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="3" Margin="0,0,24,0">
                  <TextBlock Text="{l:Tr settings.theme.title}" Classes="h3" />
                  <TextBlock Text="{l:Tr settings.theme.body}" Classes="small muted wrap" />
                </StackPanel>
                <ComboBox Grid.Column="1" ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" VerticalAlignment="Center" />
              </Grid>
            </Border>
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- Game -->
      <StackPanel Spacing="12">
        <TextBlock Text="{l:Tr settings.game}" Classes="h2" />
        <Border Classes="group">
          <StackPanel>
            <Border Classes="row">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="3" Margin="0,0,24,0">
                  <TextBlock Text="{l:Tr settings.installPath.title}" Classes="h3" />
                  <TextBlock Text="{Binding InstallPath}" Classes="path" />
                  <TextBlock Text="{l:Tr settings.installPath.locked}" Classes="small faint wrap" IsVisible="{Binding !CanChangeInstallPath}" />
                </StackPanel>
                <Button Grid.Column="1" Content="{l:Tr common.change}" Command="{Binding ChangeInstallPathCommand}" IsVisible="{Binding CanChangeInstallPath}"
                        VerticalAlignment="Center" />
              </Grid>
            </Border>
            <Border Classes="row">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="3" Margin="0,0,24,0">
                  <TextBlock Text="{l:Tr settings.gamePath.title}" Classes="h3" />
                  <TextBlock Text="{Binding GamePath}" Classes="path" />
                </StackPanel>
                <Button Grid.Column="1" Content="{l:Tr settings.gamePath.manage}" Command="{Binding ShowGamePageCommand}" VerticalAlignment="Center" />
              </Grid>
            </Border>
            <Border Classes="row">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="3" Margin="0,0,24,0">
                  <TextBlock Text="{l:Tr settings.afterLaunch.title}" Classes="h3" />
                  <TextBlock Text="{l:Tr settings.afterLaunch.body}" Classes="small muted wrap" />
                </StackPanel>
                <ComboBox Grid.Column="1" ItemsSource="{Binding AfterLaunchOptions}" SelectedItem="{Binding AfterLaunch}" VerticalAlignment="Center" />
              </Grid>
            </Border>
            <Border Classes="row">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="3" Margin="0,0,24,0">
                  <TextBlock Text="{l:Tr settings.arguments.title}" Classes="h3" />
                  <TextBlock Text="{l:Tr settings.arguments.body}" Classes="small muted wrap" />
                </StackPanel>
                <TextBox Grid.Column="1" Text="{Binding LaunchArguments}" Width="260" VerticalAlignment="Center" Classes="mono" />
              </Grid>
            </Border>
            <Border Classes="row last">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="3" Margin="0,0,24,0">
                  <TextBlock Text="{l:Tr settings.backupSaves.title}" Classes="h3" />
                  <TextBlock Text="{l:Tr settings.backupSaves.body}" Classes="small muted wrap" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding BackupSaves}" VerticalAlignment="Center" />
              </Grid>
            </Border>
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- Downloads -->
      <StackPanel Spacing="12">
        <TextBlock Text="{l:Tr settings.downloads}" Classes="h2" />
        <Border Classes="group">
          <StackPanel>
            <Border Classes="row">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="3" Margin="0,0,24,0">
                  <TextBlock Text="{l:Tr settings.parallel.title}" Classes="h3" />
                  <TextBlock Text="{l:Tr settings.parallel.body}" Classes="small muted wrap" />
                </StackPanel>
                <ComboBox Grid.Column="1" ItemsSource="{Binding ParallelOptions}" SelectedItem="{Binding Parallel}" MinWidth="120" VerticalAlignment="Center" />
              </Grid>
            </Border>
            <Border Classes="row">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="3" Margin="0,0,24,0">
                  <TextBlock Text="{l:Tr settings.speed.title}" Classes="h3" />
                  <TextBlock Text="{l:Tr settings.speed.body}" Classes="small muted wrap" />
                </StackPanel>
                <ComboBox Grid.Column="1" ItemsSource="{Binding SpeedOptions}" SelectedItem="{Binding Speed}" VerticalAlignment="Center" />
              </Grid>
            </Border>
            <Border Classes="row last">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="3" Margin="0,0,24,0">
                  <TextBlock Text="{l:Tr settings.keepCache.title}" Classes="h3" />
                  <TextBlock Text="{l:Tr settings.keepCache.body}" Classes="small muted wrap" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding KeepCache}" VerticalAlignment="Center" />
              </Grid>
            </Border>
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- Updates -->
      <StackPanel Spacing="12">
        <TextBlock Text="{l:Tr settings.updates}" Classes="h2" />
        <Border Classes="group">
          <StackPanel>
            <Border Classes="row">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="3" Margin="0,0,24,0">
                  <TextBlock Text="{l:Tr settings.checkContent.title}" Classes="h3" />
                  <TextBlock Text="{l:Tr settings.checkContent.body}" Classes="small muted wrap" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding CheckContentUpdates}" VerticalAlignment="Center" />
              </Grid>
            </Border>
            <Border Classes="row">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="3" Margin="0,0,24,0">
                  <TextBlock Text="{l:Tr settings.checkLauncher.title}" Classes="h3" />
                  <TextBlock Text="{l:Tr settings.checkLauncher.body}" Classes="small muted wrap" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding CheckLauncherUpdates}" VerticalAlignment="Center" />
              </Grid>
            </Border>
            <Border Classes="row last">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="3" Margin="0,0,24,0">
                  <TextBlock Text="{l:Tr updates.channel.title}" Classes="h3" />
                  <TextBlock Text="{l:Tr updates.channel.body}" Classes="small muted wrap" />
                </StackPanel>
                <ComboBox Grid.Column="1" ItemsSource="{Binding Channels}" SelectedItem="{Binding Channel}" VerticalAlignment="Center" />
              </Grid>
            </Border>
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- Advanced -->
      <StackPanel Spacing="12">
        <TextBlock Text="{l:Tr settings.advanced}" Classes="h2" />
        <Border Classes="group">
          <StackPanel>
            <Border Classes="row">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="3" Margin="0,0,24,0">
                  <TextBlock Text="{l:Tr settings.verbose.title}" Classes="h3" />
                  <TextBlock Text="{l:Tr settings.verbose.body}" Classes="small muted wrap" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding VerboseLogging}" VerticalAlignment="Center" />
              </Grid>
            </Border>
            <Border Classes="row">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="3" Margin="0,0,24,0">
                  <TextBlock Text="{l:Tr settings.unsupported.title}" Classes="h3" />
                  <TextBlock Text="{l:Tr settings.unsupported.body}" Classes="small muted wrap" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding AllowUnsupported}" VerticalAlignment="Center" />
              </Grid>
            </Border>
            <Border Classes="row">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="3" Margin="0,0,24,0">
                  <TextBlock Text="{l:Tr settings.developer.title}" Classes="h3" />
                  <TextBlock Text="{l:Tr settings.developer.body}" Classes="small muted wrap" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding DeveloperMode}" VerticalAlignment="Center" />
              </Grid>
            </Border>
            <Border Classes="row" IsVisible="{Binding DeveloperMode}">
              <StackPanel Spacing="10">
                <StackPanel Spacing="3">
                  <TextBlock Text="{l:Tr settings.source.title}" Classes="h3" />
                  <TextBlock Text="{l:Tr settings.source.body}" Classes="small muted wrap" />
                </StackPanel>
                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                  <ComboBox ItemsSource="{Binding SourceKinds}" SelectedItem="{Binding SourceKind}" />
                  <TextBox Grid.Column="1" Text="{Binding SourceValue}" Margin="10,0" Classes="mono" PlaceholderText="{l:Tr settings.source.placeholder}" />
                  <Button Grid.Column="2" Classes="icon" Command="{Binding BrowseSourceFolderCommand}" ToolTip.Tip="{l:Tr common.browse}" AutomationProperties.Name="{l:Tr common.browse}" Margin="0,0,8,0">
                    <PathIcon Data="{StaticResource Icon.FolderOpen}" />
                  </Button>
                  <Button Grid.Column="3" Classes="primary" Content="{l:Tr common.apply}" Command="{Binding ApplySourceCommand}" />
                </Grid>
              </StackPanel>
            </Border>
            <Border Classes="row last">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="3" Margin="0,0,24,0">
                  <TextBlock Text="{l:Tr settings.data.title}" Classes="h3" />
                  <TextBlock Text="{Binding DataFolder}" Classes="path" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <Button Content="{l:Tr settings.data.open}" Command="{Binding OpenDataFolderCommand}" />
                  <Button Content="{l:Tr settings.setupAgain}" Command="{Binding RunSetupCommand}" />
                </StackPanel>
              </Grid>
            </Border>
          </StackPanel>
        </Border>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
