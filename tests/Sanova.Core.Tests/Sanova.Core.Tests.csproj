<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Sanova.Core.Tests</RootNamespace>
    <!-- Test code: explicit StringComparison and per-call cancellation tokens add noise without value here. -->
    <NoWarn>$(NoWarn);CA1307;xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Sanova.Core\Sanova.Core.csproj" />
    <ProjectReference Include="..\..\src\Sanova.ManifestTool\Sanova.ManifestTool.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
